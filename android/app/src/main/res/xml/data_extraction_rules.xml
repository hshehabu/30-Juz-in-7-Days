<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup rules (Google cloud backup and device-to-device transfer).
  Only the app's settings file is included: it holds reading progress, history
  and settings. Everything else (scheduled-notification plugin state, widget
  data, caches) is rebuilt on first launch, so it is left out.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
